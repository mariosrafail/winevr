; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Grapes of Crete"
config/version="0.2.0"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.09, 0.14, 0.12, 1)
run/main_scene="res://scenes/WineVRExperience.tscn"
run/main_scene.grape_room_demo="res://scenes/GrapeRoomDemo.tscn"
config/name.grape_room_demo="Grapes of Crete"
run/flush_stdout_on_print.grape_room_demo=true
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

AppState="*res://scripts/app_state.gd"
WineDatabase="*res://scripts/data/WineDatabase.gd"
ClientProfileLoader="*res://core/client_profile_loader.gd"
ExperienceManager="*res://core/experience_manager.gd"
NarrativeManager="*res://core/narrative_manager.gd"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.grape_room_demo="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.android_xr="gl_compatibility"
renderer/rendering_method.android_touch="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/enabled.grape_room_demo=false
openxr/enabled.android_touch=false
openxr/default_action_map="res://scripts/vr/openxr_action_map.tres"
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=true
