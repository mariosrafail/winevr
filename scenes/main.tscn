[sub_resource type="Shader" id="24_front_label_shader"]
code = "shader_type spatial;\nrender_mode cull_disabled;\n\nfloat hash(vec2 p) {\n\treturn fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat border_mask = step(0.035, uv.x) * step(0.035, uv.y) * step(uv.x, 0.965) * step(uv.y, 0.965);\n\tfloat medallion = smoothstep(0.17, 0.16, distance(uv, vec2(0.5, 0.28)));\n\tfloat stripe = smoothstep(0.48, 0.5, abs(uv.y - 0.72));\n\tfloat crest = smoothstep(0.13, 0.0, distance(uv, vec2(0.5, 0.53)));\n\tfloat paper_noise = hash(floor(uv * vec2(180.0, 240.0))) * 0.07;\n\tvec3 paper = vec3(0.94, 0.91, 0.80) + paper_noise;\n\tvec3 ink = vec3(0.33, 0.07, 0.10);\n\tvec3 gold = vec3(0.84, 0.70, 0.34);\n\tvec3 color = mix(ink, paper, border_mask);\n\tcolor = mix(color, gold, medallion * 0.95);\n\tcolor = mix(color, ink, stripe * 0.88);\n\tcolor = mix(color, gold, crest * 0.5);\n\tALBEDO = color;\n\tROUGHNESS = 0.78;\n\tSPECULAR = 0.18;\n\tMETALLIC = medallion * 0.22;\n\tEMISSION = gold * medallion * 0.03;\n\tALPHA = 0.98;\n}"

