[sub_resource type="Shader" id="17_label_shader"]
code = "shader_type spatial;\nrender_mode cull_disabled, depth_draw_opaque;\n\nuniform vec4 base_color : source_color = vec4(0.93, 0.89, 0.77, 1.0);\nuniform vec4 accent_color : source_color = vec4(0.42, 0.08, 0.12, 1.0);\nuniform vec4 foil_color : source_color = vec4(0.83, 0.69, 0.30, 1.0);\nuniform float stripe_scale = 7.0;\nuniform float stripe_strength = 0.28;\n\nfloat hash(vec2 p) {\n\treturn fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat stripe = 0.5 + 0.5 * sin(uv.y * stripe_scale * 6.28318);\n\tfloat paper_noise = hash(floor(uv * vec2(120.0, 240.0))) * 0.08;\n\tfloat center_band = smoothstep(0.18, 0.22, uv.y) * (1.0 - smoothstep(0.78, 0.82, uv.y));\n\tfloat trim = smoothstep(0.02, 0.055, uv.y) + (1.0 - smoothstep(0.945, 0.98, uv.y));\n\tvec3 color = base_color.rgb;\n\tcolor = mix(color, accent_color.rgb, stripe * stripe_strength * center_band);\n\tcolor = mix(color, foil_color.rgb, clamp(trim, 0.0, 1.0) * 0.85);\n\tcolor += paper_noise;\n\tALBEDO = color;\n\tROUGHNESS = 0.72;\n\tSPECULAR = 0.22;\n\tMETALLIC = clamp(trim, 0.0, 1.0) * 0.25;\n\tALPHA = 0.98;\n}"

